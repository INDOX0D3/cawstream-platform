# =============================================================================
# CawStream — environment variables for a standalone VPS deployment
# Copy this file to the server (e.g. /opt/cawstream/.env) and fill in values.
# =============================================================================

# --- Frontend build (required at `bun run build` time) -----------------------
# The URL of your Convex deployment. Get it from the Convex dashboard
# (https://dashboard.convex.dev) → your project → "Deployment URL".
# Example: https://humming-otter-123.convex.cloud
VITE_CONVEX_URL=https://your-project-123.convex.cloud

# --- Convex CLI / backend deploy (required for `bunx convex deploy`) ---------
# The deployment name from the Convex dashboard, e.g. "humming-otter-123".
# Alternatively create convex.json from convex.json.example.
CONVEX_DEPLOYMENT=your-project-123

# The public HTTPS URL of your site (used by OTP emails as the app link).
# Set this in the Convex dashboard → Settings → Environment variables
# (CONVEX_SITE_URL), NOT in this file — it is read server-side.

# --- Email fallback relay (optional, server-side) ----------------------------
# Last-resort OTP relay when Admin → SMTP is not configured/verified yet.
# Only needed if you host your own relay; otherwise keep unset and configure
# Admin → SMTP in the app.
# FREEBUFF_RELAY_URL=
# FREEBUFF_RELAY_KEY=

# --- Freebuff SSO (only used on the Freebuff platform, optional) -------------
# On a standalone VPS this is not needed. Leave unset.
# VLY_CONVEX_AUTH_ISSUER=
# VLY_APP_NAME=
