# =============================================================================
# Vidood Stream — environment variables for a standalone VPS deployment
# Copy this file to the server (e.g. /opt/vidood/.env) and fill in values.
# =============================================================================

# HTTP port the backend listens on (nginx proxies to this; keep 8787)
PORT=8787

# Where the SQLite database file lives
# DATA_DIR=/opt/vidood/data

# Where uploaded videos / thumbnails / logos are stored — point this at your
# biggest data disk (e.g. /mnt/data/vidood/storage)
# STORAGE_DIR=/opt/vidood/storage

# Set to 1 when serving over HTTPS behind nginx (secure session cookie)
COOKIE_SECURE=1

# --- SMTP for OTP emails (or configure in Admin → SMTP after install) --------
# Without SMTP, OTP codes are printed to the server log so sign-up still works
# during initial setup.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# SMTP_SECURE=false
